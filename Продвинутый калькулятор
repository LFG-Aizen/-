
def summa_cifr(n):
    count = 0
    while n > 0:
        cifra = n % 10
        count += cifra
        n = n // 10
    print(f"Сумма цифр: {count}")

def max_cifra(n):
    max_c = 0
    while n > 0:
        cifra = n % 10
        if cifra > max_c:
            max_c = cifra
        n = n // 10
    print(f"Максимальная цифра: {max_c}")

def min_cifra(n):
    min_c = 9
    while n > 0:
        cifra = n % 10
        if cifra < min_c:
            min_c = cifra
        n = n // 10
    print(f"Минимальная цифра: {min_c}")


while True:
    print()
    q = int(input("Введите число:  "))
    print("1 - сумма цифр")
    print("2 - максимальная цифра")
    print("3 - минимальная цифра")

    w = int(input("Введите номер действия:  "))
    if w == 1:
        summa_cifr(q)
    elif w == 2:
        max_cifra(q)
    elif w == 3:
        min_cifra(q)
