def guess_the_number():
    print("\n--- ИГРА: УГАДАЙ ЧИСЛО ---")
    print("Я загадал число от 1 до 100. Попробуй угадать!")
    secret_number = random.randint(1, 100)
    while True:  # Бесконечный цикл, пока не угадаем
            ugadaj = int(input("Твой вариант: "))
            if ugadaj < secret_number:
                print("Неа, мое число БОЛЬШЕ.")
            elif ugadaj > secret_number:
                print("Неа мое число МЕНЬШЕ.")
            elif ugadaj == secret_number:
                print("Ты угадал!")
                print()
                print("Главное меню - 1")
                print("Сыграть еще раз - 2")
                vopros = int(input("Выберите действие:  "))
                if vopros == 1:
                    main_menu()
                elif vopros == 2:
                    guess_the_number()


def main_menu():
    print("Камень ножницы бумага - 1")
    print("Угадай число - 2")
    game = int(input("Введите действие:  "))
    if game == 1:
        rock_paper_scissors()
    elif game == 2:
        guess_the_number()

main_menu()
