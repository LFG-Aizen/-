x = int(input("Вклад в банке:  "))
p = int(input("Проценты:  "))
y = int(input("Желаемая сумма:  "))
xx = 0
while x < y:
    qwe = x * p // 100
    x += qwe
    xx += 1
print("Кол-во лет чтобы сумма вклада достигла")
print("Суммы в", y, "должно пройти ",xx,"лет")
print("Итого вы получите ", x)

